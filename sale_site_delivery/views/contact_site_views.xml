<?xml version="1.0" encoding="utf-8"?>
<!--
    Site views extended with sales information.
-->
<odoo>

    <!-- Site form: Sales Orders smart button, visible to sales users only -->
    <record id="contact_site_view_form_inherit_sale" model="ir.ui.view">
        <field name="name">contact.site.view.form.inherit.sale</field>
        <field name="model">contact.site</field>
        <field name="inherit_id" ref="contact_site.contact_site_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-dollar"
                        groups="sales_team.group_sale_salesman">
                    <field name="sale_order_count" widget="statinfo" string="Sales Orders"/>
                </button>
            </div>
        </field>
    </record>

</odoo>