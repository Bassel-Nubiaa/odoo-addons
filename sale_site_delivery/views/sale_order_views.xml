<?xml version="1.0" encoding="utf-8"?>
<!--
    Sales order views extended with the Site field.
-->
<odoo>

    <!-- Sales order form: add Site below the customer and its addresses -->
    <record id="sale_order_view_form_inherit_site" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.site</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <group name="partner_details" position="inside">
                <!-- Sites are created from Contacts > Sites, not from the order -->
                <field name="site_id" options="{'no_create': True}"/>
            </group>
        </field>
    </record>

    <!-- Sales order search: search and group orders by site -->
    <record id="sale_order_view_search_inherit_site" model="ir.ui.view">
        <field name="name">sale.order.view.search.inherit.site</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="site_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
            </xpath>
        </field>
    </record>
    <!-- Order lines: choose the source of each line (warehouse or dropship) -->
    <record id="sale_order_view_form_inherit_line_source" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.line.source</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='analytic_distribution']" position="after">
                <!-- Helper fields used by the conditions below; never displayed -->
                <field name="allowed_vendor_ids" column_invisible="True"/>
                <field name="is_source_locked" column_invisible="True"/>

                <field name="source_type"
                       optional="show"
                       invisible="display_type or product_type == 'service'"
                       readonly="is_source_locked"/>
                <field name="source_warehouse_id"
                       optional="show"
                       invisible="display_type or source_type != 'warehouse' or product_type == 'service'"
                       readonly="is_source_locked"
                       options="{'no_create': True}"/>
                <field name="dropship_vendor_id"
                       optional="show"
                       invisible="display_type or source_type != 'dropship'"
                       required="not display_type and source_type == 'dropship'"
                       readonly="is_source_locked"
                       domain="[('id', 'in', allowed_vendor_ids)]"
                       options="{'no_create': True}"/>
                <field name="delivered_by_id"
                       optional="show"
                       invisible="display_type or (product_type == 'service' and not is_shipping_line)"                       
                       required="not display_type and product_type != 'service'"
                       readonly="is_source_locked"
                       options="{'no_create': True}"/>
                <field name="is_shipping_line" column_invisible="True"/>

                <field name="delivered_by_is_employee"
                       optional="show"
                       invisible="display_type or not delivered_by_id"/>  
                <field name="is_shipping_line" column_invisible="True"/>

            </xpath>
        </field>
    </record>

        <!-- Sales order: shipping review buttons, Confirm only after the review, and the Shipping tab -->
    <record id="sale_order_view_form_inherit_shipping_review" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.shipping.review</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@id='action_confirm']" position="before">
                <button name="action_confirm_shipping"
                        type="object"
                        string="Confirm Shipping Details"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent') or shipping_reviewed or not shipping_review_required"/>
                <button name="action_reset_shipping"
                        type="object"
                        string="Reset Shipping"
                        invisible="state not in ('draft', 'sent') or not shipping_reviewed"
                        confirm="This cancels the deliveries and purchase orders created for this quotation. Continue?"/>
            </xpath>

            <!-- Standard Confirm buttons: one for sent quotations, one for drafts -->
            <xpath expr="//header/button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or (shipping_review_required and not shipping_reviewed)</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm' and not(@id)]" position="attributes">
                <attribute name="invisible">state != 'draft' or (shipping_review_required and not shipping_reviewed)</attribute>
            </xpath>

            <group name="partner_details" position="inside">
                <field name="shipping_review_required" invisible="1"/>
                <field name="shipping_reviewed" invisible="not shipping_review_required"/>
            </group>

            <!-- Shipping tab: the final overview before confirming the order -->
            <page name="order_lines" position="after">
                <page string="Shipping" name="shipping" invisible="not shipping_review_required">
                    <p class="text-muted" invisible="shipping_reviewed">
                        Click Confirm Shipping Details to prepare the deliveries and review them here.
                    </p>
                    <field name="shipping_group_ids" invisible="not shipping_reviewed" readonly="1">
                        <tree>
                            <field name="group_type"/>
                            <field name="source_name"/>
                            <field name="delivered_by_id"/>
                            <field name="is_employee"/>
                            <field name="shipping_partner_id"/>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="picking_id"/>
                            <field name="purchase_id" groups="purchase.group_purchase_user"/>
                            <field name="shipping_purchase_id" groups="purchase.group_purchase_user"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>