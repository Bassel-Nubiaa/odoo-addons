<?xml version="1.0" encoding="utf-8"?>
<!--
    Transfer views extended with the Site of the originating sales order.
-->
<odoo>

    <!-- Transfer form: show the site below the contact (read-only, set by the sales order) -->
    <record id="stock_picking_view_form_inherit_site" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.site</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="site_id" invisible="not site_id"/>
            </field>
        </field>
    </record>

    <!-- Transfer search: search and group transfers by site -->
    <record id="stock_picking_view_search_inherit_site" model="ir.ui.view">
        <field name="name">stock.picking.view.search.inherit.site</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="site_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>